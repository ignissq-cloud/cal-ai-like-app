# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Server-side secret. Used ONLY by server.js to call Gemini; never exposed to the frontend.
GEMINI_API_KEY=your-gemini-api-key

# Firebase Web config (browser-safe identifiers) — read by Vite at dev/build time.
# Used for Firebase Authentication only.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
# Reserved for Firebase Analytics — NOT initialized by the app yet.
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
